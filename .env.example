# Local development only. These database credentials are public defaults.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relay

# Local HTTP only. Production must use HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
SESSION_LIFETIME_SECONDS=86400

# Generate a Fernet key before storing provider credentials. Optional until then.
TOKEN_ENCRYPTION_KEY=

# Reserved for future integrations.
APP_SECRET=
OPENAI_API_KEY=
LANGUAGE_MODEL_PROVIDER=fake
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connections/GOOGLE/callback
GOOGLE_CALENDAR_API_BASE_URL=https://www.googleapis.com/calendar/v3
GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/connections/NOTION/callback
NOTION_API_BASE_URL=https://api.notion.com
NOTION_OAUTH_AUTHORIZE_URL=https://api.notion.com/v1/oauth/authorize
NOTION_OAUTH_TOKEN_URL=https://api.notion.com/v1/oauth/token
NOTION_PUBLISH_MODE=mock
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AGENT_RUNTIME_BASE_URL=
AGENT_RUNTIME_API_KEY=
